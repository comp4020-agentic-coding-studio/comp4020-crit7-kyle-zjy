---
import Base from "../layouts/Base.astro";
import { degreeProgress, requirementProgress } from "../lib/planner";
import { loadPlanner } from "../lib/store";

const data = loadPlanner();
const progress = degreeProgress(data.degree.totalUnits, data.catalog, data.records);
const requirements = data.requirements.map((r) => requirementProgress(r, data.catalog, data.records));
---

<Base title="Dashboard" current="dashboard">
  <h1>{data.degree.name}</h1>
  <p>{progress.completed} / {progress.total} units completed</p>
  <ul>
    {
      requirements.map((r) => (
        <li>
          {r.requirement.name}: {r.completed} / {r.required} units ({r.state})
        </li>
      ))
    }
  </ul>
</Base>
